RABBITMQ_URL=amqp://user:pass@localhost:5672/

# GCP service account used for GCS artifact read/write (pkg/common/db.py)
# safe to leave blank to just get the consumer running, but real jobs will fail
# LOCAL ONLY: set this to a fake-gcs-server and the block below can stay blank
# (see SETUP.md). dev/production leave it unset.
STORAGE_EMULATOR_HOST=
PROJECT_ID=
PRIVATE_KEY_ID=
PRIVATE_KEY=
CLIENT_EMAIL=
CLIENT_ID=
TOKEN_URI=

# optional, "true" for debug-level logging
DEBUG=